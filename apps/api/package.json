{
	"name": "@repo/api",
	"version": "0.0.1",
	"private": true,
	"description": "The Restock Express API",
	"keywords": [],
	"bugs": {
		"url": "https://github.com/bennobuilder/restock/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/bennobuilder/restock.git"
	},
	"license": "AGPL-3.0-only",
	"author": "@bennobuilder",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"source": "./src/index.ts",
			"import": "./dist/esm/index.js",
			"require": "./dist/cjs/index.cjs",
			"default": "./dist/esm/index.js"
		},
		"./openapi": {
			"types": "./dist/types/openapi/index.d.ts",
			"source": "./src/openapi/index.ts",
			"import": "./dist/openapi/esm/index.js",
			"require": "./dist/openapi/cjs/index.cjs",
			"default": "./dist/openapi/esm/index.js"
		},
		"./openapi.json": "./openapi.json",
		"./package.json": "./package.json"
	},
	"typesVersions": {
		"*": {
			".": [
				"./dist/types/index.d.ts"
			],
			"openapi": [
				"./dist/types/openapi/index.d.ts"
			]
		}
	},
	"files": [
		"dist",
		"openapi.json",
		"README.md"
	],
	"scripts": {
		"build": "shx rm -rf dist && rollup -c rollup.config.js",
		"build:prod": "export NODE_ENV=production && pnpm build",
		"clean": "shx rm -rf dist && shx rm -rf .turbo && shx rm -rf node_modules",
		"install:clean": "pnpm run clean && pnpm install",
		"lint": "eslint .",
		"openapi:generate": "pnpm run openapi:generate:runtime && pnpm run openapi:generate:types",
		"openapi:generate:runtime": "tsx scripts/generate-openapi-runtime.ts",
		"openapi:generate:types": "openapi-typescript openapi.json -o src/openapi/api-v1.gen.ts",
		"start:dev": "tsx watch --env-file-if-exists=.env.local scripts/dev.ts",
		"test": "echo \"🧪 No tests defined yet.\"",
		"typecheck": "tsc --noEmit && tsc -p scripts/tsconfig.json",
		"update:latest": "pnpm update --latest"
	},
	"dependencies": {
		"cors": "^2.8.6",
		"express": "^5.2.1",
		"openapi-ts-router": "^0.4.1",
		"validatenv": "^0.1.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@blgc/config": "^0.1.0",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/node": "^26.1.1",
		"openapi-typescript": "^7.13.0",
		"rollup-presets": "^0.0.28",
		"tsx": "^4.23.1"
	}
}
